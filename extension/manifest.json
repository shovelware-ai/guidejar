{
  "manifest_version": 3,
  "name": "Guidejar Capture",
  "version": "0.1.0",
  "description": "Record your clicks and screenshots into an interactive Guidejar guide.",
  "permissions": ["tabs", "scripting", "storage", "unlimitedStorage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Guidejar Capture"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["recorder.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
