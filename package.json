{
  "name": "guidejar-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "cf:dev": "opennextjs-cloudflare build && wrangler dev --ip 0.0.0.0 --port 8787",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
    "db:create": "wrangler d1 create guidejar",
    "db:local": "wrangler d1 migrations apply guidejar --local",
    "db:remote": "wrangler d1 migrations apply guidejar --remote",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "idb": "^8.0.3",
    "next": "16.2.6",
    "openai": "^6.39.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.97.0"
  }
}
